                bg.classList.add('active'); updatePos(t.clientX, t.clientY);
            }, {passive: false});
            bg.addEventListener('touchmove', e => {
                e.preventDefault();
                for(let i=0; i<e.changedTouches.length; i++) {
                    if (e.changedTouches[i].identifier === activeTouch) updatePos(e.changedTouches[i].clientX, e.changedTouches[i].clientY);
                }
            }, {passive: false});
            bg.addEventListener('touchend', e => {
                e.preventDefault();
                for(let i=0; i<e.changedTouches.length; i++) { if (e.changedTouches[i].identifier === activeTouch) reset(); }
            }, {passive: false});
            bg.addEventListener('touchcancel', reset, {passive: false});

            // MOUSE EVENTS
            bg.addEventListener('mousedown', e => {
                e.preventDefault(); if (activeTouch !== null) return;
                isMouseDown = true; bg.classList.add('active'); updatePos(e.clientX, e.clientY);
            });
            document.addEventListener('mousemove', e => {
                if (isMouseDown) { e.preventDefault(); updatePos(e.clientX, e.clientY); }
            }, {passive: false});
            document.addEventListener('mouseup', () => { if (isMouseDown) reset(); });
        }

        makeJoystick('slider-v-bg', 'knob-v', 'fill-v', true, updateDriveOutput);
        makeJoystick('slider-h-bg', 'knob-h', 'fill-h', false, updateSteerOutput);

        // --- Modals ---
        $('gear').onclick = async () => { const a = await api('/homeopen'); if(a !== null) {$('ang').textContent = a + '\u00b0'; $('panel').classList.add('show'); } };$('hm').onclick = async () => { const a = await api('/homestep?d=-1'); if(a!==null) $('ang').textContent = a + '\u00b0'; };$('hp').onclick = async () => { const a = await api('/homestep?d=1'); if(a!==null) $('ang').textContent = a + '\u00b0'; };
        $('save').onclick = async () => { await api('/homesave');$('panel').classList.remove('show'); };
        $('cancel').onclick = async () => { await api('/homecancel');$('panel').classList.remove('show'); };

        document.addEventListener('visibilitychange', () => { if(document.hidden) { api('/drive?d=0&v=0'); api('/steer?d=0'); } });
        api('/ping'); sendSteerSpeed();
    </script>
</body>
</html>
)rawliteral";

void sendText(const String& s) {
  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "text/plain", s);
}

void handleRoot() {
  server.sendHeader("Cache-Control", "no-store");
  server.send_P(200, "text/html", INDEX_HTML);
}

void handleDrive() {
  int d = server.arg("d").toInt();
  int v = server.arg("v").toInt();
  lastCmd = millis();
  setMotor(d, v);
  sendText("ok");
}

void handleSteer() {
  int d = server.arg("d").toInt();
  if (d == 0) {
    goHome();
  } else {
    int newDir = (d > 0) ? 1 : -1;
    if (steerDir != newDir) lastSteerStep = millis();
    steerDir = newDir;
    lastSteerCmd = millis();
  }
  sendText("ok");
}

void handleSteerSpeed() {
  int v = constrain(server.arg("v").toInt(), 1, 100);
  steerRate = v * STEER_RATE_PER_PERCENT;
  sendText("ok");
}

void handleHomeOpen() {
  servoWrite(homeAngle);
  sendText(String(homeAngle));
}

void handleHomeStep() {
  homeAngle = constrain(homeAngle + server.arg("d").toInt(), 0, 180);
  servoWrite(homeAngle);
  sendText(String(homeAngle));
}

void handleHomeSave() {
  savedHome = homeAngle;
  prefs.putInt("home", savedHome);
  servoWrite(homeAngle);
  sendText("saved");
}

void handleHomeCancel() {
  homeAngle = savedHome;
  servoWrite(homeAngle);
  sendText(String(homeAngle));
}

void handleOther() {
  sendText("ok");
}

void setup() {
  Serial.begin(115200);

  ledcAttach(MOTOR_FWD_PIN, 1000, 8);
  ledcAttach(MOTOR_BWD_PIN, 1000, 8);
  ledcAttach(SERVO_PIN, 50, 16);
  setMotor(0, 0);

  prefs.begin("spherebot", false);
  savedHome = prefs.getInt("home", DEFAULT_HOME);
  homeAngle = savedHome;
  servoWrite(homeAngle);

  WiFi.mode(WIFI_AP);
  WiFi.softAP(AP_SSID, AP_PASS);
  
  server.on("/", handleRoot);
  server.on("/drive", handleDrive);
  server.on("/steer", handleSteer);
  server.on("/steerspeed", handleSteerSpeed);
  server.on("/homeopen", handleHomeOpen);
  server.on("/homestep", handleHomeStep);
  server.on("/homesave", handleHomeSave);
  server.on("/homecancel", handleHomeCancel);
  server.onNotFound(handleOther);
  server.begin();
}

void loop() {
  server.handleClient();

  unsigned long now = millis();

  if (steerDir != 0 && now - lastSteerStep >= 10) {
    float dt = (now - lastSteerStep) / 1000.0f;
    lastSteerStep = now;
    steerOffset += steerDir * steerRate * dt;
    steerOffset = constrain(steerOffset, (float)-STEER_MAX, (float)STEER_MAX);
    servoWrite(homeAngle + (int)roundf(steerOffset));
  }

  if (motorDir != 0 && now - lastCmd > WATCHDOG_MS) {
    setMotor(0, 0);
  }

  if (steerDir != 0 && now - lastSteerCmd > WATCHDOG_MS) {
    goHome();
  }
}
