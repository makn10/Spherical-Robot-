void setMotor(int dir, int speed) {
  speed = constrain(speed, 0, 100);
  uint32_t duty = (uint32_t)speed * 255 / 100;
  if (dir == 1 && speed > 0) {
    ledcWrite(MOTOR_BWD_PIN, 0);
    ledcWrite(MOTOR_FWD_PIN, duty);
    motorDir = 1;
  } else if (dir == -1 && speed > 0) {
    ledcWrite(MOTOR_FWD_PIN, 0);
    ledcWrite(MOTOR_BWD_PIN, duty);
    motorDir = -1;
  } else {
    ledcWrite(MOTOR_FWD_PIN, 0);
    ledcWrite(MOTOR_BWD_PIN, 0);
    motorDir = 0;
  }
}

void servoWrite(int angle) {
  angle = constrain(angle, 0, 180);
  float us = SERVO_MIN_US + (SERVO_MAX_US - SERVO_MIN_US) * (angle / 180.0f);
  uint32_t duty = (uint32_t)(us * 65535.0f / 20000.0f);
  ledcWrite(SERVO_PIN, duty);
}

